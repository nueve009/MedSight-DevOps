# Copy to .env and fill in. Never commit .env.

# LLM for the parse + description steps: "groq" (default) or "ollama"
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# Shared secret the mobile app sends in the X-API-Key header
MEDSIGHT_API_KEY=

LOW_CONFIDENCE_THRESHOLD=0.55

# JSON logs on stdout: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# On a cloud host, point these at a persistent disk
# MEDSIGHT_DATA_DIR=/var/data
# MEDSIGHT_LOGS_DIR=/var/data/logs
