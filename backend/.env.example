# Copy to .env and fill in. Never commit .env.

# LLM for the parse + description steps: "groq" (default) or "ollama"
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# Web tier for unlisted medicines (M6): "tavily" plus a key turns it on; empty = off
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# WEB_SEARCH_TIMEOUT_S=8
# WEB_DEVICE_PER_DAY=3
# WEB_DAILY_BUDGET=20
# WEB_MISS_TTL_DAYS=7

# Interactive API docs at /docs, /redoc and /openapi.json. Off by default;
# turn on for local work only.
# API_DOCS=on

# Shared secret the mobile app sends in the X-API-Key header
MEDSIGHT_API_KEY=
# More keys, one per app release or tester group: name=key,name=key
# MEDSIGHT_API_KEYS=

# Rate limits (per phone, per address) and the daily model-call budget
# RATE_DEVICE_PER_MINUTE=15
# RATE_DEVICE_PER_DAY=150
# RATE_ADDRESS_PER_MINUTE=30
# LLM_DAILY_BUDGET=180
# KEY_DAILY_LLM_CAPS=testers-a=60
# On Railway: x-real-ip (its edge proxy overwrites it)
# CLIENT_IP_HEADER=
# MAX_CONCURRENT_SCANS=8

# Groq request timeout in seconds
LLM_TIMEOUT_S=15

# Scan rules: OCR confidence below this adds a spoken caveat (was
# LOW_CONFIDENCE_THRESHOLD); give up from this attempt; rescan text longer than this
OCR_CAVEAT_THRESHOLD=0.55
MAX_SCAN_ATTEMPTS=3
MAX_PARSE_CHARS=2000

# JSON logs on stdout: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Cache and scan log: "sqlite" (local file, default) or "postgres" (Supabase).
# With postgres, DATABASE_URL is the backend's own role (migrations/README.md).
# CACHE_BACKEND=sqlite
# DATABASE_URL=postgresql://medsight_backend.<project-ref>:<password>@<pooler host>:5432/postgres
# DATABASE_SSLMODE=require
# DB_CONNECT_TIMEOUT_S=2
# DB_QUERY_TIMEOUT_MS=1000
# DB_SKIP_AFTER_FAILURE_S=60
# Only for python -m scripts.migrate: the database owner's connection string
# MIGRATION_DATABASE_URL=

# On a cloud host, point these at a persistent disk
# MEDSIGHT_DATA_DIR=/var/data
# MEDSIGHT_LOGS_DIR=/var/data/logs
