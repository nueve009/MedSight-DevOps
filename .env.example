# Copy this file to .env.local and fill it in. Never commit .env.local.
#
# These values are built into the app, so anyone with the app can read them.
# Do not put real secrets (like the Groq key) here; those stay on the backend.

# Where the MedSight backend runs. Leave empty to use mock data (no server).
#   Backend on your PC, app in the Android emulator:  http://10.0.2.2:8000
#   Backend on your PC, app on a real phone:          http://<your PC's Wi-Fi IP>:8000
#   Deployed backend:                                  https://<your-backend-host>
EXPO_PUBLIC_API_BASE_URL=

# The shared key the backend checks (its MEDSIGHT_API_KEY), sent as X-API-Key.
EXPO_PUBLIC_MEDSIGHT_API_KEY=

# Supabase project URL and anonymous (public) key.
# Find both in: Supabase dashboard → Project Settings → API.
# The anon key is safe in the app bundle; NEVER put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
